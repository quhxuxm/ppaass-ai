{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug Agent",
            "type": "lldb",
            "request": "launch",
            "cargo": {
                "args": [
                    "build",
                    "--package",
                    "desktop-agent"
                ],
                "filter": {
                    "name": "desktop-agent",
                    "kind": "bin"
                }
            },
            "args": [
                "--config",
                "config/local/agent.toml"
            ],
            "cwd": "${workspaceFolder}",
            "sourceLanguages": [
                "rust"
            ],
            "stopOnEntry": false,
            "console": "integratedTerminal"
        },
        {
            "name": "Debug Proxy Entry",
            "type": "lldb",
            "request": "launch",
            "cargo": {
                "args": [
                    "build",
                    "--package",
                    "proxy-entry",
                    "--release"
                ],
                "filter": {
                    "name": "proxy-entry",
                    "kind": "bin"
                }
            },
            "args": [
                "--config",
                "config/local/proxy-entry.toml"
            ],
            "cwd": "${workspaceFolder}",
            "sourceLanguages": [
                "rust"
            ],
            "stopOnEntry": false,
            "console": "integratedTerminal"
        },
        {
            "name": "Run Mock Target",
            "type": "lldb",
            "request": "launch",
            "cargo": {
                "args": [
                    "build",
                    "--package",
                    "integration-tests"
                ],
                "filter": {
                    "name": "integration-tests",
                    "kind": "bin"
                }
            },
            "args": [
                "mock-target"
            ],
            "cwd": "${workspaceFolder}",
            "sourceLanguages": [
                "rust"
            ],
            "stopOnEntry": false,
            "console": "integratedTerminal"
        },
        {
            "name": "Run Integration Tests",
            "type": "lldb",
            "request": "launch",
            "cargo": {
                "args": [
                    "build",
                    "--package",
                    "integration-tests"
                ],
                "filter": {
                    "name": "integration-tests",
                    "kind": "bin"
                }
            },
            "args": [
                "integration",
                "--agent-addr",
                "127.0.0.1:7070",
                "--proxy-addr",
                "127.0.0.1:8080"
            ],
            "cwd": "${workspaceFolder}",
            "sourceLanguages": [
                "rust"
            ],
            "stopOnEntry": false,
            "console": "integratedTerminal"
        },
        {
            "name": "Debug Agent (Forward)",
            "type": "lldb",
            "request": "launch",
            "cargo": {
                "args": [
                    "build",
                    "--package",
                    "desktop-agent",
                ],
                "filter": {
                    "name": "desktop-agent",
                    "kind": "bin"
                }
            },
            "args": [
                "--config",
                "config/local/agent-forward.toml"
            ],
            "cwd": "${workspaceFolder}",
            "sourceLanguages": [
                "rust"
            ],
            "stopOnEntry": false,
            "console": "integratedTerminal"
        },
        {
            "name": "Debug Proxy Entry (Forward)",
            "type": "lldb",
            "request": "launch",
            "cargo": {
                "args": [
                    "build",
                    "--package",
                    "proxy-entry",
                ],
                "filter": {
                    "name": "proxy-entry",
                    "kind": "bin"
                }
            },
            "args": [
                "--config",
                "config/local/proxy-entry-forward.toml"
            ],
            "cwd": "${workspaceFolder}",
            "sourceLanguages": [
                "rust"
            ],
            "stopOnEntry": false,
            "console": "integratedTerminal"
        }
    ],
    "compounds": [
        {
            "name": "Debug Agent & Proxy Entry",
            "configurations": [
                "Debug Agent",
                "Debug Proxy Entry",
            ]
        },
        {
            "name": "Debug Agent & Proxy Entry (Forward)",
            "configurations": [
                "Debug Agent (Forward)",
                "Debug Proxy Entry (Forward)",
                "Debug Proxy Entry"
            ]
        }
    ]
}
